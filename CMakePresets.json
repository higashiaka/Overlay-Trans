{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (CPU)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64"
    },
    {
      "name": "windows-x64-vulkan",
      "displayName": "Windows x64 (Vulkan GPU)",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/vk",
      "cacheVariables": {
        "GGML_VULKAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-vulkan",
      "configurePreset": "windows-x64-vulkan",
      "configuration": "Release"
    }
  ]
}
