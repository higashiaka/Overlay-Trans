{
  "manifest_version": 3,
  "minimum_chrome_version": "96",
  "name": "OverLay-Trans",
  "version": "1.5.0",
  "description": "OverLay-Trans 앱이 만든 실시간 번역 자막을 방송 영상 위에 표시합니다.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OverLay-Trans",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content/sites/twitch.js", "content/overlay.js", "content/main.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/sites/youtube.js", "content/overlay.js", "content/main.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
